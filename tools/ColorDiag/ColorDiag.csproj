<Project Sdk="Microsoft.NET.Sdk">

  <!-- 動画の白潰れの原因を調べる診断用。配布するアプリには含めない -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>StepRecorder.ColorDiag</AssemblyName>
    <RootNamespace>StepRecorder.ColorDiag</RootNamespace>
    <ApplicationManifest>../../src/StepRecorder.App/app.manifest</ApplicationManifest>
    <!-- アプリ(exe)を参照したまま、単一ファイルの自己完結で発行する -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 製品と同じ録画・エンコード・読み戻しのコードで調べる -->
    <ProjectReference Include="..\..\src\StepRecorder.App\StepRecorder.App.csproj" />
  </ItemGroup>

</Project>
