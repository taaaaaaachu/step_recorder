<Window x:Class="StepRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="step_recorder" SizeToContent="Height" Width="520" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="Yu Gothic UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Label"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <Label Content="対象アプリ"/>
            <ComboBox x:Name="Processes" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label"/>
            <Button Grid.Column="2" Content="更新" Click="Refresh_Click"/>

            <Label Grid.Row="1" Content="撮影モード"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ModeClick" Content="クリックごと" Margin="0,0,12,0"/>
                <RadioButton x:Name="ModeManual" Content="手動" Margin="0,0,12,0"/>
                <RadioButton x:Name="ModeWindow" Content="画面切り替わり検知"/>
            </StackPanel>

            <Label Grid.Row="2" Content="出力先"/>
            <TextBox x:Name="OutputDir" Grid.Row="2" Grid.Column="1"/>
            <Button Grid.Row="2" Grid.Column="2" Content="参照" Click="Browse_Click"/>

            <Label Grid.Row="3" Content="切り替わり後の待ち(ms)"/>
            <TextBox x:Name="Delay" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

            <Label Grid.Row="4" Content="手動撮影キー"/>
            <TextBox x:Name="HkCapture" Grid.Row="4" Grid.Column="1"/>
            <Label Grid.Row="5" Content="一時停止キー"/>
            <TextBox x:Name="HkPause" Grid.Row="5" Grid.Column="1"/>
            <Label Grid.Row="6" Content="停止キー"/>
            <TextBox x:Name="HkStop" Grid.Row="6" Grid.Column="1"/>

            <Label Grid.Row="7" Content="同じ画面の扱い"/>
            <ComboBox x:Name="Group" Grid.Row="7" Grid.Column="1" Margin="0,3" SelectedIndex="0">
                <ComboBoxItem Content="手順モード(撮った順に並べる)"/>
                <ComboBoxItem Content="画面一覧モード(画面ごとにまとめる)"/>
            </ComboBox>

            <Label Grid.Row="8" Content="自動更新"/>
            <CheckBox x:Name="AutoUpdate" Grid.Row="8" Grid.Column="1" Content="起動時に新しいバージョンを確認する" VerticalAlignment="Center" Click="AutoUpdate_Click"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="記録を開く..." Click="Open_Click"/>
            <Button Content="記録開始" Click="Start_Click" IsDefault="True" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock x:Name="Version" Foreground="Gray" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
