<Window x:Class="StepRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="step_recorder" SizeToContent="Height" Width="520" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="Yu Gothic UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/></Style> <!-- Fluent のラベルは右に余白がなく、隣の欄とくっつく -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
        <!-- Fluent のラジオボタンは最小幅が広く、間が空きすぎる -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}"><Setter Property="MinWidth" Value="0"/></Style>
        <!-- ショートカットキー欄: フォーカスが当たるとキー入力待ちになり、押した組み合わせがそのまま入る -->
        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="クリックしてから、Ctrl・Alt・Shift・Win と組み合わせたキーを押してください。Esc で取り消し。押しても反応しない組み合わせは、他のアプリが使用中です。"/>
            <EventSetter Event="GotKeyboardFocus" Handler="Hotkey_GotKeyboardFocus"/>
            <EventSetter Event="LostKeyboardFocus" Handler="Hotkey_LostKeyboardFocus"/>
            <EventSetter Event="PreviewKeyDown" Handler="Hotkey_PreviewKeyDown"/>
            <EventSetter Event="PreviewKeyUp" Handler="Hotkey_PreviewKeyUp"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <!-- 編集画面の「続けて記録」から来たときだけ出す。保存先はその記録のフォルダに決まる -->
        <Border x:Name="AppendPanel" Visibility="Collapsed" Background="#FFE8EEF7" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="やめて編集に戻る" Click="CancelAppend_Click"/>
                <TextBlock x:Name="AppendLabel" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="AppendLabel"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <Label Content="対象"/>
            <ComboBox x:Name="Targets" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label" SelectionChanged="Targets_SelectionChanged" DropDownOpened="Targets_DropDownOpened"/>
            <Button Grid.Column="2" Content="更新" Click="Refresh_Click"/>

            <Label Grid.Row="1" Content="撮影モード"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ModeClick" Content="クリックごと" Margin="0,0,12,0"/>
                <RadioButton x:Name="ModeManual" Content="手動" Margin="0,0,12,0"/>
                <RadioButton x:Name="ModeRecord" Content="録画"/>
            </StackPanel>

            <Label Grid.Row="2" Content="フレームレート"/>
            <ComboBox x:Name="Fps" Grid.Row="2" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" MinWidth="110" AutomationProperties.Name="フレームレート"/>

            <Label Grid.Row="3" Content="出力先"/>
            <TextBox x:Name="OutputDir" Grid.Row="3" Grid.Column="1"/>
            <Button x:Name="BrowseButton" Grid.Row="3" Grid.Column="2" Content="参照" Click="Browse_Click"/>

            <Label Grid.Row="4" Content="手動撮影キー"/>
            <TextBox x:Name="HkCapture" Grid.Row="4" Grid.Column="1" Style="{StaticResource HotkeyBox}"/>
            <Label Grid.Row="5" Content="一時停止キー"/>
            <TextBox x:Name="HkPause" Grid.Row="5" Grid.Column="1" Style="{StaticResource HotkeyBox}"/>
            <Label Grid.Row="6" Content="停止キー"/>
            <TextBox x:Name="HkStop" Grid.Row="6" Grid.Column="1" Style="{StaticResource HotkeyBox}"/>
            <Label Grid.Row="7" Content="録画キー"/>
            <TextBox x:Name="HkClip" Grid.Row="7" Grid.Column="1" Style="{StaticResource HotkeyBox}"/>

            <Label Grid.Row="8" Content="同じ画面の扱い"/>
            <ComboBox x:Name="Group" Grid.Row="8" Grid.Column="1" Margin="0,3" SelectedIndex="0">
                <ComboBoxItem Content="手順モード(撮った順に並べる)"/>
                <ComboBoxItem Content="画面一覧モード(画面ごとにまとめる)"/>
            </ComboBox>

            <Label Grid.Row="9" Content="マウスカーソル"/>
            <CheckBox x:Name="CaptureCursor" Grid.Row="9" Grid.Column="1" Content="スクリーンショットと動画に写す" VerticalAlignment="Center"/>

            <Label Grid.Row="10" Content="自動更新"/>
            <DockPanel Grid.Row="10" Grid.Column="1">
                <Button x:Name="CheckUpdate" DockPanel.Dock="Right" Content="今すぐ確認" Click="CheckUpdate_Click"/>
                <CheckBox x:Name="AutoUpdate" Content="起動時に新しいバージョンを確認する" VerticalAlignment="Center" Click="AutoUpdate_Click"/>
            </DockPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="記録を開く..." Click="Open_Click"/>
            <Button Content="記録開始" Click="Start_Click" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Padding="12,4" Margin="4,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Version" Foreground="Gray" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
