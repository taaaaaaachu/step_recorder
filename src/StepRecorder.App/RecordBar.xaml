<Window x:Class="StepRecorder.App.RecordBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="step_recorder 記録中" SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" FontFamily="Yu Gothic UI" FontSize="12"
        ThemeMode="Dark" Background="#FF2B2B2B" Foreground="White"
        MouseLeftButtonDown="Bar_MouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="8,2"/><Setter Property="Focusable" Value="False"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Focusable" Value="False"/><Setter Property="MinWidth" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid>
    <!-- 記録中だと分かる赤い枠。Fluent のウインドウは自分の枠線を描かないので Border で描く -->
    <Border x:Name="Panel" BorderBrush="#FFE04040" BorderThickness="2">
    <StackPanel Orientation="Horizontal" Margin="8,5">
        <TextBlock x:Name="State" Text="● 記録中" Foreground="#FFFF6060" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <RadioButton x:Name="ModeClick" Content="クリック" Checked="Mode_Checked"/>
        <RadioButton x:Name="ModeManual" Content="手動" Checked="Mode_Checked"/>
        <Button x:Name="CaptureButton" Content="撮影" Click="Capture_Click"/>
        <Button x:Name="ClipButton" Content="● 録画" Click="Clip_Click" ToolTip="押してから操作し、もう一度押すと動画のステップになります"/>
        <Button x:Name="PauseButton" Content="一時停止" Click="Pause_Click"/>
        <Button Content="停止" Click="Stop_Click"/>
        <TextBlock x:Name="Count" Text="0 枚" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
    </StackPanel>
    </Border>
    <!-- 引っ込んでいる間に出すタブ。マウスを乗せるか押すとバーが出る。赤 ● 記録中、赤 ■ 動画のステップを録画中、灰 ❚❚ 一時停止 -->
    <Button x:Name="BarTab" Visibility="Collapsed" Click="BarTab_Click" Background="#FFE04040" Content="●"
            AutomationProperties.AutomationId="BarTab" AutomationProperties.Name="記録バーを開く">
        <Button.Style>
            <!-- Fluent のボタンは最小の高さと余白が大きく、タブにならない -->
            <Style TargetType="Button">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Width="56" Height="14" Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>
    </Button>
    </Grid>
</Window>
