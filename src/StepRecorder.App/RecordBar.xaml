<Window x:Class="StepRecorder.App.RecordBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="step_recorder 記録中" Width="760" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" FontFamily="Yu Gothic UI" FontSize="12"
        ThemeMode="Dark" Background="Transparent" Foreground="White"
        MouseLeftButtonDown="Bar_MouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="8,2"/><Setter Property="Focusable" Value="False"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Focusable" Value="False"/><Setter Property="MinWidth" Value="0"/>
        </Style>
    </Window.Resources>
    <!--
        ウィンドウは透明で大きさも位置も変えない(伸縮させながら動かすとちらつく)。開閉は中身を上端の外へ滑らせる。
        透明な所のクリックは下のウィンドウへ通る。幅はいちばん長い文言(録画停止 + 時刻)でも収まる大きさ
    -->
    <Grid>
    <!-- 記録中だと分かる赤い枠。Fluent のウインドウは自分の枠線を描かないので Border で描く -->
    <Border x:Name="Panel" BorderBrush="#FFE04040" BorderThickness="2" Background="#FF2B2B2B" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Border.RenderTransform><TranslateTransform x:Name="PanelSlide"/></Border.RenderTransform>
    <StackPanel Orientation="Horizontal" Margin="8,5">
        <TextBlock x:Name="State" Text="● 記録中" Foreground="#FFFF6060" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <RadioButton x:Name="ModeClick" Content="クリック" Checked="Mode_Checked"/>
        <RadioButton x:Name="ModeManual" Content="手動" Checked="Mode_Checked"/>
        <Button x:Name="CaptureButton" Content="撮影" Click="Capture_Click"/>
        <Button x:Name="ClipButton" Content="● 録画" Click="Clip_Click" ToolTip="押してから操作し、もう一度押すと動画のステップになります"/>
        <Button x:Name="PauseButton" Content="一時停止" Click="Pause_Click"/>
        <Button Content="停止" Click="Stop_Click"/>
        <TextBlock x:Name="Count" Text="0 枚" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
        <!-- ピン。アイコンは Windows 同梱のフォント(11 は Segoe Fluent Icons、10 は Segoe MDL2 Assets)。外すと線画の E718、留めると針が刺さって隠れた E842。E840 は 11 では E718 と同じ絵なので使わない -->
        <ToggleButton x:Name="PinButton" Margin="4,0,0,0" Checked="Pin_Changed" Unchecked="Pin_Changed" ToolTip="バーを引っ込めない"
                      AutomationProperties.AutomationId="PinButton" AutomationProperties.Name="バーを引っ込めない">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Face" Width="24" Height="22" CornerRadius="3" Background="Transparent">
                                    <TextBlock x:Name="Icon" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#FFB8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Face" Property="Background" Value="#FF454545"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Face" Property="Background" Value="#FFE04040"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                                        <Setter TargetName="Icon" Property="Text" Value="&#xE842;"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>
    </StackPanel>
    </Border>
    <!-- 引っ込んでいる間に出すタブ。マウスを乗せるか押すとバーが出る。赤 ● 記録中、赤 ■ 動画のステップを録画中、灰 ❚❚ 一時停止 -->
    <Button x:Name="BarTab" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top" Click="BarTab_Click" Background="#FFE04040" Content="●"
            AutomationProperties.AutomationId="BarTab" AutomationProperties.Name="記録バーを開く">
        <Button.RenderTransform><TranslateTransform x:Name="TabSlide" Y="-14"/></Button.RenderTransform>
        <Button.Style>
            <!-- Fluent のボタンは最小の高さと余白が大きく、タブにならない -->
            <Style TargetType="Button">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Width="56" Height="14" Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>
    </Button>
    </Grid>
</Window>
