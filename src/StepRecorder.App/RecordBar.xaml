<Window x:Class="StepRecorder.App.RecordBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="step_recorder 記録中" Width="760" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" FontFamily="Yu Gothic UI" FontSize="12"
        ThemeMode="Dark" Background="Transparent" Foreground="White"
        MouseLeftButtonDown="Bar_MouseLeftButtonDown">
    <Window.Resources>
        <!--
            平らなボタン。Tag にアイコン(Segoe Fluent Icons / Segoe MDL2 Assets の字)、Content に文言。
            アイコンの色は BorderBrush で変える(録画は赤)。乗せると明るく、押すとさらに明るくなる
        -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="#FFF0F0F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFF0F0F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="6" Background="{TemplateBinding Background}" Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{TemplateBinding BorderBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF3D3D3D"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FF4D4D4D"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- 停止は記録を終える操作なので、赤く塗って目立たせる(乗せたときも赤のまま明るく) -->
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Background" Value="#FFC42B1C"/>
            <Setter Property="Margin" Value="4,0,2,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFD83B2B"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FFA82315"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- 撮影モードの切り替え。2 つを 1 つの枠に並べ、選んでいる方を明るくする(セグメント) -->
        <Style TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#FFB8B8B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" CornerRadius="4" Background="Transparent" Padding="10,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FF4A4A4A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
        ウィンドウは透明で大きさも位置も変えない(伸縮させながら動かすとちらつく)。開閉は中身を上端の外へ滑らせる。
        透明な所のクリックは下のウィンドウへ通る。幅はいちばん長い文言(録画停止 + 時刻)でも収まる大きさ
    -->
    <Grid>
    <!-- 記録中だと分かる赤い枠。Fluent のウインドウは自分の枠線を描かないので Border で描く -->
    <Border x:Name="Panel" BorderBrush="#FFE04040" BorderThickness="1.5" CornerRadius="0,0,10,10" Background="#FF202020" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Border.RenderTransform><TranslateTransform x:Name="PanelSlide"/></Border.RenderTransform>
    <StackPanel Orientation="Horizontal" Margin="10,6">
        <TextBlock x:Name="State" Text="● 記録中" Foreground="#FFFF6060" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,10,0"/>
        <Border x:Name="ModeGroup" Background="#FF141414" CornerRadius="6" Padding="2" Margin="0,0,6,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeClick" Content="クリック" Checked="Mode_Checked"/>
                <RadioButton x:Name="ModeManual" Content="手動" Checked="Mode_Checked"/>
            </StackPanel>
        </Border>
        <Button x:Name="CaptureButton" Style="{StaticResource BarButton}" Tag="&#xE722;" Content="撮影" Click="Capture_Click"/>
        <Button x:Name="ClipButton" Style="{StaticResource BarButton}" Tag="&#xE7C8;" BorderBrush="#FFFF5050" Content="録画" Click="Clip_Click"
                ToolTip="押してから操作し、もう一度押すと動画のステップになります"/>
        <Button x:Name="PauseButton" Style="{StaticResource BarButton}" Tag="&#xE769;" Content="一時停止" Click="Pause_Click"/>
        <Button Style="{StaticResource StopButton}" Tag="&#xE71A;" Content="停止" Click="Stop_Click"/>
        <Border Background="#FF333333" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="Count" Text="0 枚" Foreground="#FFD0D0D0" MinWidth="32" TextAlignment="Center"/>
        </Border>
        <!-- ピン。アイコンは Windows 同梱のフォントの線画(11 は Segoe Fluent Icons、10 は Segoe MDL2 Assets)。外すと E718、留めると針が真下を向いたピン。E840 はどちらのフォントでも針が左下 45 度なので、-45 度回す(E718 は 10 では横向きなので回しても揃わない) -->
        <ToggleButton x:Name="PinButton" Margin="4,0,0,0" Checked="Pin_Changed" Unchecked="Pin_Changed" ToolTip="バーを引っ込めない"
                      AutomationProperties.AutomationId="PinButton" AutomationProperties.Name="バーを引っ込めない">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Face" Width="28" Height="26" CornerRadius="6" Background="Transparent">
                                    <TextBlock x:Name="Icon" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#FFB8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Face" Property="Background" Value="#FF454545"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Face" Property="Background" Value="#FFE04040"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                                        <Setter TargetName="Icon" Property="Text" Value="&#xE840;"/>
                                        <Setter TargetName="Icon" Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="-45"/></Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Icon" Property="Margin" Value="0,-3,0,0"/> <!-- 回すと針の分だけ下に寄る -->
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>
    </StackPanel>
    </Border>
    <!-- 引っ込んでいる間に出すタブ。マウスを乗せるか押すとバーが出る。赤 ● 記録中、赤 ■ 動画のステップを録画中、灰 ❚❚ 一時停止 -->
    <Button x:Name="BarTab" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top" Click="BarTab_Click" Background="#FFE04040" Content="●"
            AutomationProperties.AutomationId="BarTab" AutomationProperties.Name="記録バーを開く">
        <Button.RenderTransform><TranslateTransform x:Name="TabSlide" Y="-14"/></Button.RenderTransform>
        <Button.Style>
            <!-- Fluent のボタンは最小の高さと余白が大きく、タブにならない -->
            <Style TargetType="Button">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Width="56" Height="14" CornerRadius="0,0,6,6" Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>
    </Button>
    </Grid>
</Window>
