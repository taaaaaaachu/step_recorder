<Window x:Class="StepRecorder.App.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:StepRecorder.App"
        Title="step_recorder 編集" Width="1280" Height="820"
        FontFamily="Yu Gothic UI" FontSize="13" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}"><Setter Property="Margin" Value="0,0,8,0"/></Style> <!-- Fluent のラベルは右に余白がなく、隣の欄とくっつく -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}"><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinWidth" Value="0"/></Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/><ColumnDefinition Width="8"/><ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="↑" Click="Up_Click" ToolTip="上へ (Alt+↑)"/>
                <Button Content="↓" Click="Down_Click" ToolTip="下へ (Alt+↓)"/>
                <Button Content="削除" Click="DeleteStep_Click" ToolTip="削除 (Delete)"/>
            </StackPanel>
            <ListBox x:Name="Steps" SelectionChanged="Steps_SelectionChanged" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- 画面一覧モードのときの、画面ごとの見出し(出力でまとまる単位) -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#FFE8EEF7" Padding="6,3" Margin="0,6,0,2">
                                    <TextBlock>
                                        <Run Text="{Binding Name.Name, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0} ステップ)}" Foreground="#555"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Image DockPanel.Dock="Left" Source="{Binding Thumb}" Width="110" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" Foreground="#555" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <StackPanel.Resources>
                    <!-- ボタンをドロップダウンと同じ高さに伸ばす(Fluent のボタンは文字の高さで止まり、ドロップダウンより低い) -->
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/></Style>
                </StackPanel.Resources>
                <Label Content="出力の並べ方" VerticalAlignment="Center"/>
                <ComboBox x:Name="Group" Width="230" Margin="0,0,10,0" VerticalContentAlignment="Center" SelectionChanged="Group_SelectionChanged">
                    <ComboBoxItem Content="手順モード(撮った順)"/>
                    <ComboBoxItem Content="画面一覧モード(画面ごと)"/>
                </ComboBox>
                <Button x:Name="UndoButton" Content="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" MinWidth="36" VerticalAlignment="Stretch" Margin="0,0,2,0"
                        Click="Undo_Click" AutomationProperties.Name="元に戻す" ToolTip="元に戻す (Ctrl+Z)" IsEnabled="False"/>
                <Button x:Name="RedoButton" Content="&#xE7A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" MinWidth="36" VerticalAlignment="Stretch"
                        Click="Redo_Click" AutomationProperties.Name="やり直す" ToolTip="やり直す (Ctrl+Y)" IsEnabled="False"/>
                <!-- フロッピーのアイコン。Segoe Fluent Icons には塗りつぶしの保存アイコンが無いので線画 -->
                <Button x:Name="SaveButton" Content="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" MinWidth="36" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Stretch" Padding="10,3" Margin="0,0,6,0" AutomationProperties.Name="保存" ToolTip="保存 (Ctrl+S)"/>
                <Button Content="HTMLを開く" Click="OpenHtml_Click"/>
                <Button Content="フォルダを開く" Click="OpenFolder_Click"/>
                <!-- 保存して開始画面に戻り、選び直した対象で同じ記録の末尾に足す -->
                <Button Content="続けて記録" Click="Continue_Click" ToolTip="保存して開始画面に戻り、この記録の続きを記録する"/>
                <!-- 本体はフォルダに書き出す。右の矢印で、HTML 1 ファイルなどの書き出し方を選ぶ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                    <Button Content="配布用に書き出す..." Click="ExportFolder_Click" Margin="0" AutomationProperties.AutomationId="ExportButton"/>
                    <Button x:Name="ExportMenuButton" Click="ExportMenuButton_Click" Margin="1,0,0,0" Padding="6,3"
                            AutomationProperties.AutomationId="ExportMenuButton" AutomationProperties.Name="ほかの書き出し方">
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="フォルダに書き出す..." Click="ExportFolder_Click"/>
                                <MenuItem Header="HTML 1 ファイルに書き出す..." Click="ExportSingle_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <ComboBox x:Name="ClipFormatBox" MinWidth="90" VerticalContentAlignment="Center" ToolTip="動画形式"
                          SelectionChanged="ClipFormat_SelectionChanged">
                    <ComboBoxItem Content="MP4"/>
                    <ComboBoxItem Content="GIF"/>
                </ComboBox>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="画面名"/>
                <TextBox x:Name="ScreenName" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                         TextChanged="ScreenName_TextChanged" LostFocus="Field_LostFocus"/>
                <Label Grid.Row="1" Content="説明"/>
                <TextBox x:Name="Description" Grid.Row="1" Grid.Column="1" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="70" VerticalScrollBarVisibility="Auto" TextChanged="Description_TextChanged" LostFocus="Field_LostFocus"/>
            </Grid>

            <!-- 幅が足りないときは折り返す -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <RadioButton x:Name="ToolSelect" Content="選択・移動" IsChecked="True"/>
                <RadioButton x:Name="ToolAdd" Content="強調枠を追加"/>
                <RadioButton x:Name="ToolCrop" Content="トリミング"/>
                <Button Content="選択した枠を削除" Click="DeleteHighlight_Click" ToolTip="選択した枠を削除 (Delete)"/>
                <Button Content="トリミング解除" Click="ClearCrop_Click"/>
                <Button x:Name="PlayButton" Content="▶ 再生" Click="Play_Click" Visibility="Collapsed"/>
                <ComboBox x:Name="SpeedBox" MinWidth="110" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" SelectionChanged="Speed_SelectionChanged"
                          AutomationProperties.Name="再生の速さ"/>
                <ComboBox x:Name="FpsBox" MinWidth="90" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" SelectionChanged="Fps_SelectionChanged"
                          AutomationProperties.Name="フレームレート"/>
                <CheckBox x:Name="KeysBox" Content="キー表示" Margin="0,0,10,0" MinWidth="0" VerticalAlignment="Center" Visibility="Collapsed" Checked="Keys_Click" Unchecked="Keys_Click"/>
                <CheckBox x:Name="MouseBox" Content="マウス表示" Margin="0,0,10,0" MinWidth="0" VerticalAlignment="Center" Visibility="Collapsed" Checked="Mouse_Click" Unchecked="Mouse_Click"/>
                <CheckBox x:Name="AudioBox" Content="音声" Margin="0,0,10,0" MinWidth="0" VerticalAlignment="Center" Visibility="Collapsed" Checked="Audio_Click" Unchecked="Audio_Click"/>
                <Separator Margin="6,2,12,2"/>
                <Button Content="−" Click="ZoomOut_Click" ToolTip="縮小 (Ctrl+ホイール / Ctrl+-)" MinWidth="30"/>
                <TextBlock x:Name="ZoomLabel" AutomationProperties.AutomationId="ZoomLabel" Text="100%" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="+" Click="ZoomIn_Click" ToolTip="拡大 (Ctrl+ホイール / Ctrl++)" MinWidth="30"/>
                <Button Content="100%" Click="ZoomActual_Click" ToolTip="等倍 (Ctrl+0)"/>
                <Button Content="全体" Click="ZoomFit_Click"/>
                <Button x:Name="PopOutButton" Content="別ウインドウで表示" Click="PopOut_Click"/>
            </WrapPanel>

            <!-- TickFrequency が大きいのは、Ticks が空のとき WPF が 1 秒おきに目盛りを描かないようにするため -->
            <!-- 録画モードの全編のシークバーと操作。動画はメインの表示欄に出す。好きな時刻のフレームや区間をステップとして足す -->
            <Border x:Name="TimelinePanel" DockPanel.Dock="Bottom" Margin="0,6,0,0" BorderBrush="#ccc" BorderThickness="1" Padding="6" Visibility="Collapsed">
                <StackPanel>
                    <!-- シークバーは左右いっぱい。スクロールバーは常に出す(拡大したときに高さが変わると、押しているボタンが動いてしまう) -->
                    <ScrollViewer x:Name="TimeScroller" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                  SizeChanged="TimeScroller_SizeChanged" PreviewMouseWheel="TimeScroller_PreviewMouseWheel">
                        <Slider x:Name="TimeSlider" AutomationProperties.AutomationId="TimeSlider" IsMoveToPointEnabled="True" TickPlacement="BottomRight" TickFrequency="1E9"
                                Margin="0,0,0,12" SmallChange="0.1" LargeChange="1" ValueChanged="TimeSlider_ValueChanged" Thumb.DragCompleted="TimeSlider_DragCompleted" PreviewKeyDown="TimeSlider_PreviewKeyDown"
                                ToolTip="←→ でコマ送り、Ctrl+ホイールで拡大、ホイールで横に移動"/>
                    </ScrollViewer>
                    <DockPanel Margin="0,6,0,0">
                        <!-- 読み上げ名は画像のズームのボタンと区別するため -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock x:Name="TimeLabel" Text="0:00.0" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <Button Content="−" MinWidth="30" Click="TimeZoomOut_Click" AutomationProperties.Name="タイムラインを縮小" ToolTip="タイムラインを縮小 (Ctrl+ホイール)"/>
                            <Button Content="+" MinWidth="30" Click="TimeZoomIn_Click" AutomationProperties.Name="タイムラインを拡大" ToolTip="タイムラインを拡大 (Ctrl+ホイール)"/>
                            <Button Content="全体" Margin="0" Click="TimeZoomFit_Click" AutomationProperties.Name="タイムライン全体"/>
                        </StackPanel>
                        <!-- 幅が足りないときは折り返す -->
                        <WrapPanel>
                            <!-- 続けて記録した記録は全編が何本かある。2 本以上のときだけ出す -->
                            <ComboBox x:Name="FullVideoBox" MinWidth="90" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"
                                      SelectionChanged="FullVideo_SelectionChanged" AutomationProperties.AutomationId="FullVideoBox" AutomationProperties.Name="全編の動画"/>
                            <Button x:Name="FullPlayButton" Content="&#xF5B0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" MinWidth="36" VerticalAlignment="Stretch" Click="FullPlay_Click"
                                    AutomationProperties.Name="再生"/>
                            <Button Content="このフレームをステップに追加" Click="AddFrame_Click"/>
                            <Button Content="区間の開始" Margin="14,0,6,0" Click="RangeStart_Click"/>
                            <Button Content="区間の終了" Click="RangeEnd_Click"/>
                            <Button Content="区間を動画ステップに追加" Click="AddRange_Click"/>
                            <TextBlock x:Name="RangeLabel" VerticalAlignment="Center" Foreground="#555"/>
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 録画ボタンで録った動画のステップのシークバー。塗った所が使う区間。ファイルは切らず、区間だけを変える -->
            <Border x:Name="ClipPanel" DockPanel.Dock="Bottom" Margin="0,6,0,0" BorderBrush="#ccc" BorderThickness="1" Padding="6" Visibility="Collapsed">
                <StackPanel>
                    <Slider x:Name="ClipSlider" AutomationProperties.AutomationId="ClipSlider" IsMoveToPointEnabled="True" IsSelectionRangeEnabled="True"
                            SmallChange="0.1" LargeChange="1" ValueChanged="ClipSlider_ValueChanged" PreviewKeyDown="ClipSlider_PreviewKeyDown"
                            ToolTip="←→ でコマ送り"/>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="ClipTimeLabel" DockPanel.Dock="Right" Text="0:00.0" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <WrapPanel>
                            <Button Content="開始位置" Click="ClipStart_Click"/>
                            <Button Content="終了位置" Click="ClipEnd_Click"/>
                            <Button Content="分割" Margin="14,0,6,0" Click="ClipSplit_Click"/>
                            <TextBlock x:Name="ClipRangeLabel" VerticalAlignment="Center" Foreground="#555"/>
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 表示欄。「別ウインドウ」で PreviewBorder を別のウインドウへ移し、閉じたらここへ戻す -->
            <ContentControl x:Name="PreviewSlot" Focusable="False">
                <Border x:Name="PreviewBorder" BorderBrush="#ccc" BorderThickness="1" Background="#f4f4f4">
                    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  SizeChanged="Scroller_SizeChanged" PreviewMouseWheel="Scroller_PreviewMouseWheel"
                                  PreviewMouseDown="Scroller_PreviewMouseDown" PreviewMouseMove="Scroller_PreviewMouseMove" PreviewMouseUp="Scroller_PreviewMouseUp">
                        <Grid x:Name="Stage" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.LayoutTransform><ScaleTransform x:Name="Zoom"/></Grid.LayoutTransform>
                            <Image x:Name="Picture" Stretch="Fill"/>
                            <app:VideoView x:Name="Player" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <!-- 再生中の動画に重ねるキー。トリミングしているときはその範囲の下に出す(書き出しと同じ見た目) -->
                            <app:MouseOverlayView x:Name="MouseView" Visibility="Collapsed"/>
                            <Canvas x:Name="KeysLayer" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                                <app:KeyOverlayView x:Name="KeysView"/>
                            </Canvas>
                            <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True"
                                    MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </ContentControl>
        </DockPanel>
    </Grid>
</Window>
